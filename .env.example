# Copia este archivo a .env y ajusta lo que uses.
# Sin credenciales la app corre igual, con fuentes "mock" (datos de ejemplo).

# ---------- selección de fuentes ----------
# AMAZON_SOURCE:   mock | keepa | paapi
# ML_SOURCE:       mock | api
# SUPPLIER_SOURCE: mock | manual | http
AMAZON_SOURCE=mock
ML_SOURCE=mock
SUPPLIER_SOURCE=mock

# ---------- Amazon: Keepa (recomendado) ----------
# https://keepa.com/#!api — da BSR, reseñas, ofertas, dimensiones, fecha de alta
# y, en muchos ASIN, las unidades vendidas del último mes.
KEEPA_API_KEY=
KEEPA_DOMAIN=1          # 1=.com 2=.co.uk 3=.de 4=.fr 8=.it 9=.es 10=.in 11=.com.mx

# ---------- Amazon: Product Advertising API (gratis, requiere Afiliados) ----------
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.com
PAAPI_REGION=us-east-1

# ---------- Mercado Libre ----------
# App en https://developers.mercadolibre.com (grant client_credentials)
ML_SITE=MLM             # MLM=México MLC=Chile MLA=Argentina MCO=Colombia MLB=Brasil MPE=Perú
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ---------- Proveedores ----------
# Alibaba no tiene API pública abierta. Opciones:
#   manual -> cotizaciones que capturas tú en data/supplier_quotes.json
#   http   -> tu propio gateway o un proveedor de datos B2B
SUPPLIER_HTTP_ENDPOINT=
SUPPLIER_HTTP_KEY=
SUPPLIER_MANUAL_FILE=data/supplier_quotes.json

# ---------- filtros de producto ----------
MAX_WEIGHT_G=900
MAX_LONGEST_SIDE_MM=380
MIN_PRICE_USD=12
MAX_PRICE_USD=70
MAX_PRODUCT_AGE_DAYS=540

# ---------- supuestos de costo ----------
FREIGHT_MODE=air        # air | sea
AIR_USD_PER_KG=7.5
SEA_USD_PER_KG=2.2
DUTY_RATE=0.08
AMAZON_REFERRAL_RATE=0.15
ML_COMMISSION_RATE=0.16
INBOUND_PREP_USD=0.35
TARGET_ROI=1.0
TARGET_MARGIN=0.25

# ---------- runtime ----------
DB_PATH=productscout.db
REQUEST_TIMEOUT=25
