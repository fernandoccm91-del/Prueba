# Clave gratis de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto el Flash más reciente del plan gratis)
GEMINI_MODEL=gemini-flash-latest

# Twilio (consola > Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del Sandbox de WhatsApp de Twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Números autorizados a usar el bot, separados por coma (vacío = todos)
ALLOWED_NUMBERS=whatsapp:+56912345678

# Opcional: tu email, NCBI lo pide como buena práctica para usar PubMed
NCBI_EMAIL=
