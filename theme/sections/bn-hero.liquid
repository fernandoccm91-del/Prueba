{%- comment -%}
  Hero de portada — imagen a sangre con bloque de texto superpuesto.
  Vende el resultado (un baño ordenado), no el objeto.
{%- endcomment -%}

<section class="bn-hero" style="--bn-hero-alto: {{ section.settings.alto }}vh;">
  {%- if section.settings.imagen != blank -%}
    <img
      class="bn-hero__media"
      src="{{ section.settings.imagen | image_url: width: 2400 }}"
      srcset="{{ section.settings.imagen | image_url: width: 800 }} 800w,
              {{ section.settings.imagen | image_url: width: 1400 }} 1400w,
              {{ section.settings.imagen | image_url: width: 2400 }} 2400w"
      sizes="100vw"
      alt="{{ section.settings.imagen.alt | escape }}"
      width="{{ section.settings.imagen.width }}"
      height="{{ section.settings.imagen.height }}"
      fetchpriority="high">
  {%- else -%}
    <div class="bn-hero__media bn-hero__media--vacio"></div>
  {%- endif -%}

  <div class="bn-hero__velo" style="opacity: {{ section.settings.velo | divided_by: 100.0 }};"></div>

  <div class="bn-hero__contenido bn-hero__contenido--{{ section.settings.alineacion }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bn-eyebrow bn-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="bn-titulo bn-titulo--xl bn-hero__titulo">{{ section.settings.titulo }}</h1>

    {%- if section.settings.bajada != blank -%}
      <p class="bn-texto bn-texto--grande bn-hero__bajada">{{ section.settings.bajada }}</p>
    {%- endif -%}

    <div class="bn-hero__acciones">
      {%- if section.settings.boton_texto != blank -%}
        <a href="{{ section.settings.boton_url | default: '#' }}" class="bn-boton">
          {{ section.settings.boton_texto }}
        </a>
      {%- endif -%}
      {%- if section.settings.enlace_texto != blank -%}
        <a href="{{ section.settings.enlace_url | default: '#' }}" class="bn-enlace">
          {{ section.settings.enlace_texto }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .bn-hero {
    position: relative;
    min-height: var(--bn-hero-alto);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .bn-hero__media {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }
  #shopify-section-{{ section.id }} .bn-hero__media--vacio { background: var(--arena); }
  #shopify-section-{{ section.id }} .bn-hero__velo {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(28,25,23,0.55), rgba(28,25,23,0) 60%);
  }
  #shopify-section-{{ section.id }} .bn-hero__contenido {
    position: relative;
    max-width: var(--ancho-max);
    margin-inline: auto;
    width: 100%;
    padding: 0 24px 72px;
  }
  #shopify-section-{{ section.id }} .bn-hero__contenido--centro { text-align: center; }
  #shopify-section-{{ section.id }} .bn-hero__eyebrow,
  #shopify-section-{{ section.id }} .bn-hero__titulo { color: {{ section.settings.color_texto }}; }
  #shopify-section-{{ section.id }} .bn-hero__bajada {
    color: {{ section.settings.color_texto }};
    opacity: 0.88;
    max-width: 44ch;
    margin: 16px 0 32px;
  }
  #shopify-section-{{ section.id }} .bn-hero__contenido--centro .bn-hero__bajada { margin-inline: auto; }
  #shopify-section-{{ section.id }} .bn-hero__acciones {
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .bn-hero__contenido--centro .bn-hero__acciones { justify-content: center; }
  #shopify-section-{{ section.id }} .bn-hero__acciones .bn-boton {
    background: {{ section.settings.color_texto }};
    border-color: {{ section.settings.color_texto }};
    color: var(--tinta);
  }
  #shopify-section-{{ section.id }} .bn-hero__acciones .bn-boton:hover {
    background: transparent; color: {{ section.settings.color_texto }};
  }
  #shopify-section-{{ section.id }} .bn-hero__acciones .bn-enlace {
    color: {{ section.settings.color_texto }};
    border-bottom-color: {{ section.settings.color_texto }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .bn-hero { min-height: 82vh; }
    #shopify-section-{{ section.id }} .bn-hero__contenido { padding: 0 20px 48px; }
  }
</style>

{% schema %}
{
  "name": "Hero de portada",
  "tag": "section",
  "class": "bn-seccion-hero",
  "settings": [
    { "type": "image_picker", "id": "imagen", "label": "Imagen de fondo",
      "info": "Un baño real completo con tus productos. Nunca fondo blanco de catálogo." },
    { "type": "range", "id": "alto", "min": 60, "max": 100, "step": 5, "unit": "vh",
      "label": "Alto", "default": 85 },
    { "type": "range", "id": "velo", "min": 0, "max": 80, "step": 5, "unit": "%",
      "label": "Oscurecer para legibilidad", "default": 45 },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Sets coordinados" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Tu baño, por fin ordenado." },
    { "type": "textarea", "id": "bajada", "label": "Bajada",
      "default": "Piezas coordinadas en materiales nobles, pensadas para que todo combine sin que tengas que pensarlo." },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Ver los sets" },
    { "type": "url", "id": "boton_url", "label": "Enlace del botón" },
    { "type": "text", "id": "enlace_texto", "label": "Enlace secundario", "default": "Arma el tuyo →" },
    { "type": "url", "id": "enlace_url", "label": "URL del enlace secundario" },
    { "type": "select", "id": "alineacion", "label": "Alineación", "default": "izquierda",
      "options": [
        { "value": "izquierda", "label": "Izquierda" },
        { "value": "centro", "label": "Centro" }
      ] },
    { "type": "color", "id": "color_texto", "label": "Color del texto", "default": "#F5F1EC" }
  ],
  "presets": [{ "name": "Hero de portada" }]
}
{% endschema %}
